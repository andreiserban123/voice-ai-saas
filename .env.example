# Copy to .env.local. Matches the local-only database in compose.yaml.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/voice_ai_saas
# Generate a random secret with: openssl rand -base64 32
AUTH_SECRET=
# Use this exact origin in the browser. Remote deployments require HTTPS.
AUTH_URL=http://localhost:3000
# Local inbox: npm run services:up, then http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=pam@example.test
# Set both for your production SMTP provider; leave unset for local Mailpit.
# SMTP_USER=
# SMTP_PASSWORD=
# First phone call: server-only credentials. Voice stays inactive until all are set.
# The existing AUTH_SECRET also signs short-lived SIP routing tokens.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
# Signing secret from the OpenAI project webhook settings, not the API key.
OPENAI_WEBHOOK_SECRET=
# Public HTTPS origin of this persistent Node server (for example your tunnel).
# Keep AUTH_URL=http://localhost:3000 when using the dashboard locally.
VOICE_PUBLIC_URL=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin
VOICE_MAX_CALLS=3
VOICE_MAX_SECONDS=600
# For a remote container, bind its internal HTTP port on all interfaces.
# HOSTNAME_BIND=0.0.0.0
